# Runtime timezone used by Node.js and the scheduled cleanup process.
TZ=Asia/Bangkok

# Canonical public URLs. Do not add a trailing slash.
# NEXTAUTH_URL is a legacy name still consumed when the app builds invite links.
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Docker Compose PostgreSQL credentials.
POSTGRES_USER=krunangfah
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=krunangfah

# Runtime queries use PgBouncer on 6432. Prisma CLI/migrations use PostgreSQL on 5434.
DATABASE_URL="postgresql://krunangfah:replace-with-a-long-random-password@127.0.0.1:6432/krunangfah?connection_limit=10&pool_timeout=30&connect_timeout=10"
DIRECT_URL="postgresql://krunangfah:replace-with-a-long-random-password@127.0.0.1:5434/krunangfah?connect_timeout=10"

# Use redis in production. "memory" is suitable only for a single local process.
RATE_LIMIT_DRIVER=redis
REDIS_URL=redis://127.0.0.1:6379

# Password-reset email. Leave RESEND_API_KEY empty only when the feature is not used locally.
RESEND_API_KEY=
EMAIL_FROM="Krunangfah <noreply@example.com>"

# One-time bootstrap values for `npx prisma db seed`.
# Remove ADMIN_PASSWORD after the first successful seed; rerunning seed resets this password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
